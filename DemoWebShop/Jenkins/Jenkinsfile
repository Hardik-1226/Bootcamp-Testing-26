pipeline {
    agent any

    tools {
        maven 'Maven'
        jdk 'JDK22'
    }

    environment {
        PROJECT_NAME = 'DemoWebShop Automation'
        ALLURE_RESULTS = 'allure-results'
        SCREENSHOTS_DIR = 'screenshots'
        TEST_OUTPUT = 'test-output'
    }

    stages {

        stage('Checkout') {
            steps {
                echo '--- Checking out source code ---'
                checkout scm
            }
        }

        stage('Build') {
            steps {
                echo '--- Building the project ---'
                bat 'mvn clean compile -DskipTests'
            }
        }

        stage('Generate Test Data') {
            steps {
                echo '--- Generating Excel test data ---'
                bat 'mvn exec:java -Dexec.mainClass="com.demowebshop.utils.TestDataGenerator"'
            }
        }

        stage('Run Selenium Tests') {
            steps {
                echo '--- Running Selenium + TestNG tests ---'
                bat 'mvn test -DsuiteXmlFile=testng.xml'
            }
            post {
                always {
                    echo '--- Archiving test results ---'
                    junit allowEmptyResults: true, testResults: '**/target/surefire-reports/*.xml'
                }
            }
        }

        stage('Run API Tests') {
            steps {
                echo '--- Running REST Assured API tests ---'
                bat 'mvn test -Dtest="com.demowebshop.api.*"'
            }
        }

        stage('Generate Allure Report') {
            steps {
                echo '--- Generating Allure Report ---'
                allure includeProperties: false,
                       jdk: '',
                       results: [[path: "${ALLURE_RESULTS}"]]
            }
        }
    }

    post {
        always {
            echo '--- Archiving Artifacts ---'

            // Archive Screenshots
            archiveArtifacts artifacts: "${SCREENSHOTS_DIR}/**/*.png",
                             allowEmptyArchive: true,
                             fingerprint: true

            // Archive Surefire Reports
            archiveArtifacts artifacts: 'target/surefire-reports/**/*',
                             allowEmptyArchive: true

            // Archive TestNG Reports
            archiveArtifacts artifacts: "${TEST_OUTPUT}/**/*",
                             allowEmptyArchive: true

            // Publish HTML Report
            publishHTML(target: [
                allowMissing: true,
                alwaysLinkToLastBuild: true,
                keepAll: true,
                reportDir: "${TEST_OUTPUT}",
                reportFiles: 'index.html',
                reportName: 'TestNG Report'
            ])

            echo '--- Pipeline Completed ---'
        }

        success {
            echo '--- BUILD SUCCESSFUL ---'
        }

        failure {
            echo '--- BUILD FAILED ---'
        }
    }
}
